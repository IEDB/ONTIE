    <!-- https://ontology.iedb.org/ontology/ONTIE_0003304 -->

    <owl:Class rdf:about="https://ontology.iedb.org/ontology/ONTIE_0003304">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000011"/>
        <obo:IAO_0000112>Administeration of the annual flu vacccine to a human subject.</obo:IAO_0000112>
        <obo:IAO_0000115>Administering a vaccine to an organism with the intention of inducing immunity against antigen components of the vaccine.</obo:IAO_0000115>
        <obo:IAO_0000234>IEDB</obo:IAO_0000234>
        <rdfs:label>vaccination</rdfs:label>
        <ontology:ONTIE_0003303>VO:0000002</ontology:ONTIE_0003303>
    </owl:Class>
    


    <!-- https://ontology.iedb.org/ontology/ONTIE_0003305 -->

    <owl:Class rdf:about="https://ontology.iedb.org/ontology/ONTIE_0003305">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000112>Exposure of a human to Timothy grass pollen without any allergic symptoms.</obo:IAO_0000112>
        <obo:IAO_0000115>An unplanned process in which an organism comes into contact with a substance without evidence for a disease caused by that exposure.</obo:IAO_0000115>
        <obo:IAO_0000234>IEDB</obo:IAO_0000234>
        <rdfs:label>exposure to substance without evidence for disease</rdfs:label>
    </owl:Class>
    


    <!-- https://ontology.iedb.org/ontology/ONTIE_0003306 -->

    <owl:Class rdf:about="https://ontology.iedb.org/ontology/ONTIE_0003306">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0008150"/>
        <obo:IAO_0000112>A restaurant worker tests positive for presence of Norovirus, but experiences no symptoms of illness.</obo:IAO_0000112>
        <obo:IAO_0000115>A process in which an infectious agent is in or on the body of an organism without causing detectable disease.</obo:IAO_0000115>
        <obo:IAO_0000234>IEDB</obo:IAO_0000234>
        <rdfs:label>occurrence of asymptomatic infection</rdfs:label>
    </owl:Class>
    


    <!-- https://ontology.iedb.org/ontology/ONTIE_0003307 -->

    <owl:Class rdf:about="https://ontology.iedb.org/ontology/ONTIE_0003307">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000112>A restaurant worker tests positive for presence of Norovirus, but experiences no symptoms of illness.</obo:IAO_0000112>
        <obo:IAO_0000115>A process in which an organism is exposed to a substance which is evident from process having been observed or documented.</obo:IAO_0000115>
        <obo:IAO_0000234>IEDB</obo:IAO_0000234>
        <rdfs:label>documented exposure without evidence for disease</rdfs:label>
    </owl:Class>
    


    <!-- https://ontology.iedb.org/ontology/ONTIE_0003308 -->

    <owl:Class rdf:about="https://ontology.iedb.org/ontology/ONTIE_0003308">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000112>Exposure of a human to Timothy grass pollen in an area where it is known to be common during pollen season without experiencing any allergic symptoms.</obo:IAO_0000112>
        <obo:IAO_0000115>A process in which an organism&apos;s exposure to a material entity is assumed from that material being commonly present in the environment of the organism.</obo:IAO_0000115>
        <obo:IAO_0000234>IEDB</obo:IAO_0000234>
        <rdfs:label>environmental exposure to endemic/ubiquitous agent without evidence for disease</rdfs:label>
    </owl:Class>
    


    <!-- https://ontology.iedb.org/ontology/ONTIE_0003309 -->

    <owl:Class rdf:about="https://ontology.iedb.org/ontology/ONTIE_0003309">
        <rdfs:subClassOf rdf:resource="https://ontology.iedb.org/ontology/ONTIE_0003651"/>
        <obo:IAO_0000112>The information that a human has never lived in nor visted an area where Dengue virus is common.</obo:IAO_0000112>
        <obo:IAO_0000115>An organism&apos;s lifspan which does not include exposure to a substance of interest.</obo:IAO_0000115>
        <obo:IAO_0000234>IEDB</obo:IAO_0000234>
        <rdfs:label>no exposure</rdfs:label>
    </owl:Class>
    


    <!-- https://ontology.iedb.org/ontology/ONTIE_0003310 -->

    <owl:Class rdf:about="https://ontology.iedb.org/ontology/ONTIE_0003310">
        <rdfs:subClassOf rdf:resource="https://ontology.iedb.org/ontology/ONTIE_0003651"/>
        <obo:IAO_0000112>The lack of information regarding if a human has ever lived in or visted an area where Dengue virus is common.</obo:IAO_0000112>
        <obo:IAO_0000115>An organism&apos;s lifespan for which there is no available information on an exposure to a material entity of interest.</obo:IAO_0000115>
        <obo:IAO_0000234>IEDB</obo:IAO_0000234>
        <rdfs:label>unknown</rdfs:label>
    </owl:Class>
    


    <!-- https://ontology.iedb.org/ontology/ONTIE_0003311 -->

    <owl:Class rdf:about="https://ontology.iedb.org/ontology/ONTIE_0003311">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000011"/>
        <obo:IAO_0000112>The process of surgically attaching a donor kidney into a recipient patient.</obo:IAO_0000112>
        <obo:IAO_0000115>A planned process in which solid tissue is transferred to an organism.</obo:IAO_0000115>
        <obo:IAO_0000234>IEDB</obo:IAO_0000234>
        <rdfs:label>solid tissue transplantation</rdfs:label>
        <ontology:ONTIE_0003303>OGMS:0000144</ontology:ONTIE_0003303>
    </owl:Class>
    


    <!-- https://ontology.iedb.org/ontology/ONTIE_0003312 -->

    <owl:Class rdf:about="https://ontology.iedb.org/ontology/ONTIE_0003312">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000011"/>
        <obo:IAO_0000112>The process of administering donated blood into a recipient patient.</obo:IAO_0000112>
        <obo:IAO_0000115>A planned process in which a bodily fluid is transferred into an organism.</obo:IAO_0000115>
        <obo:IAO_0000234>IEDB</obo:IAO_0000234>
        <rdfs:label>transfusion</rdfs:label>
        <ontology:ONTIE_0003303>OGMS:0000145</ontology:ONTIE_0003303>
    </owl:Class>
    


    <!-- https://ontology.iedb.org/ontology/ONTIE_0003313 -->

    <owl:Class rdf:about="https://ontology.iedb.org/ontology/ONTIE_0003313">
        <rdfs:subClassOf rdf:resource="https://ontology.iedb.org/ontology/ONTIE_0003322"/>
        <obo:IAO_0000112>The process of human T-lymphotropic virus replicating in a subject prior to their development of adult T-cell leukemia/lymphoma.</obo:IAO_0000112>
        <obo:IAO_0000115>An occurence of cancer where there is evidence for the presence of a cancer causing oncovirus in the tumor.</obo:IAO_0000115>
        <obo:IAO_0000234>IEDB</obo:IAO_0000234>
        <rdfs:label>occurrence of cancer associated with virus</rdfs:label>
    </owl:Class>
    


    <!-- https://ontology.iedb.org/ontology/ONTIE_0003314 -->

    <owl:Class rdf:about="https://ontology.iedb.org/ontology/ONTIE_0003314">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000011"/>
        <obo:IAO_0000115>A planned process by which a material is intentionally given to an organism resulting in exposure of the organism to that substance.</obo:IAO_0000115>
        <obo:IAO_0000234>IEDB</obo:IAO_0000234>
        <rdfs:label>administering substance in vivo</rdfs:label>
        <ontology:ONTIE_0003303>We intend to map this term to OBI:0600007</ontology:ONTIE_0003303>
    </owl:Class>
    


    <!-- https://ontology.iedb.org/ontology/ONTIE_0003315 -->

    <owl:Class rdf:about="https://ontology.iedb.org/ontology/ONTIE_0003315">
        <rdfs:subClassOf rdf:resource="https://ontology.iedb.org/ontology/ONTIE_0003314"/>
        <obo:IAO_0000112>Administration of Leishmania major into Balb/c mice after they were immunized with a peptide vaccine in order to test if the vaccine results in less disease symptoms when compared to mice who did not receive the vaccine.</obo:IAO_0000112>
        <obo:IAO_0000115>Administering an infectious agent to an organism in order to test if and how an infection will occurr</obo:IAO_0000115>
        <obo:IAO_0000234>IEDB</obo:IAO_0000234>
        <rdfs:label>infectious challenge</rdfs:label>
        <ontology:ONTIE_0003303>We intend to map this term to OBI:0000712.</ontology:ONTIE_0003303>
    </owl:Class>
    


    <!-- https://ontology.iedb.org/ontology/ONTIE_0003316 -->

    <owl:Class rdf:about="https://ontology.iedb.org/ontology/ONTIE_0003316">
        <rdfs:subClassOf rdf:resource="https://ontology.iedb.org/ontology/ONTIE_0003314"/>
        <obo:IAO_0000112>The process of surgically attaching a donor kidney into a recipient patient.</obo:IAO_0000112>
        <obo:IAO_0000115>Transfering a solid tissue (transplant) or bodily fluid (transfusion) to an organism.</obo:IAO_0000115>
        <obo:IAO_0000234>IEDB</obo:IAO_0000234>
        <rdfs:label>transplantation or transfusion</rdfs:label>
        <ontology:ONTIE_0003303>OGMS:0000143</ontology:ONTIE_0003303>
    </owl:Class>
    


    <!-- https://ontology.iedb.org/ontology/ONTIE_0003317 -->

    <owl:Class rdf:about="https://ontology.iedb.org/ontology/ONTIE_0003317">
        <rdfs:subClassOf rdf:resource="https://ontology.iedb.org/ontology/ONTIE_0003322"/>
        <obo:IAO_0000112>The process of developing fever, chills, and congestion after being infected with influenza A virus.</obo:IAO_0000112>
        <obo:IAO_0000115>The process in which an infectious disease unfolds.</obo:IAO_0000115>
        <obo:IAO_0000234>IEDB</obo:IAO_0000234>
        <rdfs:label>occurrence of infectious disease</rdfs:label>
